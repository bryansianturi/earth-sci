---
import BaseLayout from '../core/layouts/BaseLayout.astro';
import LevelBadge from '../core/components/LevelBadge.astro';
import { getTopics, getArticles, topicOf, slugOf } from '../core/content/api';
import { t } from '../core/i18n/t';
import type { EmbedMeta } from '../core/embed/types';

const base = import.meta.env.BASE_URL;
const topics = await getTopics();
const articles = await getArticles();
const metas = Object.values(import.meta.glob<EmbedMeta>('/src/modules/*/{sims,tools}/*/meta.json', { eager: true, import: 'default' }));
const interactive = metas.map((m) => {
  const host = articles.find((a) => new RegExp(`\\{\\{\\s*${m.kind}:${m.id}[\\s}]`).test(a.body ?? ''));
  return { ...m, href: host ? `${base}${topicOf(host.id)}/${slugOf(host.id)}/#embed-${m.id}` : undefined };
});
---
<BaseLayout>
  <div class="page">
    <section class="hero">
      <div class="eyebrow">Offline earth science</div>
      <h1>How the Earth works, wherever you are.</h1>
      <p>{t('site.tagline')}</p>
      <a class="btn" href="#topics">{t('home.readArticles')} →</a>
    </section>

    <h2 class="section" id="topics">{t('home.topics')}</h2>
    <div class="card-grid">
      {topics.map((topic) => {
        const list = articles.filter((a) => topicOf(a.id) === topic.id);
        return (
          <a class="card" href={`${base}${topic.id}/`} style={`--accent: oklch(0.5 0.12 ${topic.data.hue})`}>
            <div class="eyebrow">{list.length} articles</div>
            <h3>{topic.data.title}</h3>
            <p>{topic.data.summary}</p>
          </a>
        );
      })}
    </div>

    <h2 class="section">{t('home.interactive')}</h2>
    <div class="card-grid">
      {interactive.map((m) => (
        <a class="card" href={m.href}>
          <div class="eyebrow">{m.kind === 'sim' ? 'Simulation' : 'Tool'}</div>
          <h3>{m.title}</h3>
          <p>{m.description}</p>
        </a>
      ))}
    </div>

    <h2 class="section">Latest articles</h2>
    <div class="card-grid">
      {articles.map((a) => (
        <a class="card" href={`${base}${topicOf(a.id)}/${slugOf(a.id)}/`}>
          <div><LevelBadge level={a.data.level} /></div>
          <h3>{a.data.title}</h3>
          <p>{a.data.summary}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
