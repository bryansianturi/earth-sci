---
import BaseLayout from '../../core/layouts/BaseLayout.astro';
import LevelBadge from '../../core/components/LevelBadge.astro';
import { getTopics, getArticles, slugOf } from '../../core/content/api';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}
const { topic } = Astro.props;
const articles = await getArticles(topic.id);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={topic.data.title} description={topic.data.summary}>
  <div class="page">
    <section class="hero">
      <div class="eyebrow"><a href={base}>Topics</a></div>
      <h1>{topic.data.title}</h1>
      <p>{topic.data.summary}</p>
    </section>
    <h2 class="section">Read in this order</h2>
    <div class="card-grid">
      {articles.map((a, i) => (
        <a class="card" href={`${base}${topic.id}/${slugOf(a.id)}/`}>
          <div class="eyebrow">Part {i + 1} · <LevelBadge level={a.data.level} /></div>
          <h3>{a.data.title}</h3>
          <p>{a.data.summary}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
