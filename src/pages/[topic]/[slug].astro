---
import { render } from 'astro:content';
import BaseLayout from '../../core/layouts/BaseLayout.astro';
import LevelBadge from '../../core/components/LevelBadge.astro';
import { getTopics, getArticles, topicOf, slugOf } from '../../core/content/api';
import { t } from '../../core/i18n/t';

export async function getStaticPaths() {
  const articles = await getArticles();
  const topics = await getTopics();
  return articles.map((article) => ({
    params: { topic: topicOf(article.id), slug: slugOf(article.id) },
    props: { article, topic: topics.find((x) => x.id === topicOf(article.id))! },
  }));
}
const { article, topic } = Astro.props;
const { Content, headings } = await render(article);
const siblings = await getArticles(topic.id);
const all = await getArticles();
const idx = siblings.findIndex((a) => a.id === article.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const related = article.data.related.map((id) => all.find((a) => a.id === id)!);
const base = import.meta.env.BASE_URL;
const href = (id: string) => `${base}${topicOf(id)}/${slugOf(id)}/`;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={article.data.title} description={article.data.summary}>
  <div class="page">
    <div class="article-grid">
      <nav class="side topic-side" aria-label={t('article.inThisTopic')}>
        <h2><a href={`${base}${topic.id}/`}>{topic.data.title}</a></h2>
        <ol>
          {siblings.map((a) => (
            <li><a href={href(a.id)} aria-current={a.id === article.id ? 'page' : undefined}>{a.data.title}</a></li>
          ))}
        </ol>
        {related.length > 0 && (
          <>
            <h2>{t('article.related')}</h2>
            <ul>{related.map((r) => <li><a href={href(r.id)}>{r.data.title}</a></li>)}</ul>
          </>
        )}
      </nav>

      <article>
        <header class="article-head">
          <div class="eyebrow"><a href={`${base}${topic.id}/`}>{topic.data.title}</a></div>
          <h1>{article.data.title}</h1>
          <p class="lede">{article.data.summary}</p>
          <div class="article-meta">
            <LevelBadge level={article.data.level} />
            <span>{t("article.updated")} {article.data.updated.toISOString().slice(0, 10)}</span>
            {article.data.tags.map((tag) => <span>#{tag}</span>)}
          </div>
        </header>
        <div class="prose"><Content /></div>

        <section class="prose sources" aria-label="Sources">
          <h2>Sources</h2>
          <ul>
            {article.data.sources.map((s) => (
              <li>{s.title}{s.url && <> — <code>{s.url}</code></>}</li>
            ))}
          </ul>
        </section>

        <nav class="pager" aria-label="Article navigation">
          {prev ? <a class="card prev" href={href(prev.id)}><small>← {t('article.previous')}</small>{prev.data.title}</a> : <span />}
          {next ? <a class="card next" href={href(next.id)}><small>{t('article.next')} →</small>{next.data.title}</a> : <span />}
        </nav>
      </article>

      <nav class="side toc-side" aria-label={t('article.onThisPage')}>
        <h2>{t('article.onThisPage')}</h2>
        <ol>
          {toc.map((h) => <li class={`h${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    </div>
  </div>
</BaseLayout>
