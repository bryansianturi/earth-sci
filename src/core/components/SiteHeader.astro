---
import { t } from '../i18n/t';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={base}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="#1f6a80"/><path d="M6 13c4-5 9-4 11-1s6 2 9-1c0 8-5 15-11 15S5 21 6 13z" fill="#7fb77e"/></svg>
      <span>{t('site.title')}</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      <a href={base} aria-current={path === base ? 'page' : undefined}>{t('nav.home')}</a>
      <a href={`${base}#topics`}>{t('nav.topics')}</a>
    </nav>
    <div class="header-spacer"></div>
    <div class="search" id="search-box" role="search">
      <svg class="glass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder={t('search.placeholder')} aria-label={t('nav.search')} autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" />
      <kbd aria-hidden="true">/</kbd>
      <ul class="search-results" id="search-results" role="listbox" hidden></ul>
    </div>
    <button class="icon-btn" id="theme-toggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
      <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg>
      <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </div>
</header>
